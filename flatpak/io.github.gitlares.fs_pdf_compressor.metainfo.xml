<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.gitlares.fs_pdf_compressor</id>

  <name>FS PDF Compressor</name>
  <summary>Compress PDF files locally, without uploading them</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>

  <description>
    <p>
      FS PDF Compressor is a small desktop utility to reduce the file size
      of PDF documents entirely on your own machine. No file is ever
      uploaded to a server: compression runs locally using Ghostscript.
    </p>
    <p>Features:</p>
    <ul>
      <li>Drag and drop one or several PDF files to compress them</li>
      <li>Optional Drop Zone shortcut on the desktop for quick access</li>
      <li>Choose between different compression levels</li>
      <li>Works fully offline</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.gitlares.fs_pdf_compressor.desktop</launchable>

  <categories>
    <category>Utility</category>
    <category>Office</category>
  </categories>

  <url type="homepage">https://github.com/gitlares/fs-pdf-compressor</url>
  <url type="bugtracker">https://github.com/gitlares/fs-pdf-compressor/issues</url>

  <screenshots>
